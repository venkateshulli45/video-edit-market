datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleRequestStatus {
  pending
  approved
  rejected
}

enum PricingModel {
  fixed
  hourly
  negotiable
}

enum ProposalStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum ContractStatus {
  active
  submitted
  revision_requested
  completed
  disputed
  refunded
}

enum MilestoneStatus {
  pending
  funded
  released
  disputed
}

enum DeliveryStatus {
  pending_review
  accepted
  rejected
}

enum TransactionType {
  escrow_deposit
  escrow_release
  escrow_refund
  platform_fee
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum DisputeStatus {
  open
  resolved_refunded
  resolved_released
  resolved_split
}

enum NotificationType {
  job_update
  proposal_update
  contract_update
  message
  payment
  system
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String            @unique
  passwordHash     String            @map("password_hash")
  isActive         Boolean           @default(true) @map("is_active")
  expiresAt        DateTime?         @map("expires_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  userRoles        UserRole[]
  clientProfile    ClientProfile?
  providerProfile  ProviderProfile?
  jobs             Job[]
  proposals        Proposal[]
  clientContracts  Contract[]        @relation("ClientContracts")
  providerContracts Contract[]       @relation("ProviderContracts")
  sentTransactions Transaction[]     @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")
  raisedDisputes   Dispute[]
  reviewsWritten   Review[]          @relation("ReviewsWritten")
  reviewsReceived  Review[]          @relation("ReviewsReceived")
  chatMembers      ChatMember[]
  messages         Message[]
  notifications    Notification[]

  @@map("users")
}

model Role {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String            @map("user_id") @db.Uuid
  roleId     String            @map("role_id") @db.Uuid
  status     RoleRequestStatus @default(approved)
  assignedAt DateTime          @default(now()) @map("assigned_at") @db.Timestamptz
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model ClientProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String   @map("full_name")
  phoneNumber String?  @map("phone_number")
  avatarUrl   String?  @map("avatar_url")
  address     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ProviderProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  fullName      String   @map("full_name")
  phoneNumber   String?  @map("phone_number")
  avatarUrl     String?  @map("avatar_url")
  address       String?
  bio           String?
  skills        String[] @default([])
  portfolioUrls String[] @default([]) @map("portfolio_urls")
  hourlyRate    Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  averageRating Decimal  @default(0.00) @map("average_rating") @db.Decimal(3, 2)
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_profiles")
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique
  parentId    String?    @map("parent_id") @db.Uuid
  description String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("CategoryHierarchy")
  jobs        Job[]

  @@map("categories")
}

model Job {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String          @map("client_id") @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  title          String
  description    String
  location       String?
  pricingModel   PricingModel    @map("pricing_model")
  budget         Decimal         @db.Decimal(12, 2)
  deadline       DateTime?       @db.Timestamptz
  status         String          @default("posted")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  client         User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments    JobAttachment[]
  proposals      Proposal[]
  contracts      Contract[]
  chatRooms      ChatRoom[]

  @@map("jobs")
}

model JobAttachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  fileUrl   String   @map("file_url")
  fileName  String   @map("file_name")
  fileSize  Int?     @map("file_size")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_attachments")
}

model Proposal {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String         @map("job_id") @db.Uuid
  providerId    String         @map("provider_id") @db.Uuid
  bidAmount     Decimal        @map("bid_amount") @db.Decimal(12, 2)
  estimatedDays Int?           @map("estimated_days")
  proposalText  String         @map("proposal_text")
  status        ProposalStatus @default(pending)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider      User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  contract      Contract?

  @@unique([jobId, providerId], name: "unique_job_provider_proposal")
  @@map("proposals")
}

model Contract {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String         @map("job_id") @db.Uuid
  proposalId   String?        @unique @map("proposal_id") @db.Uuid
  clientId     String         @map("client_id") @db.Uuid
  providerId   String         @map("provider_id") @db.Uuid
  agreedPrice  Decimal        @map("agreed_price") @db.Decimal(12, 2)
  status       ContractStatus @default(active)
  startedAt    DateTime       @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime?      @map("ended_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  proposal     Proposal?      @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  client       User           @relation("ClientContracts", fields: [clientId], references: [id], onDelete: Restrict)
  provider     User           @relation("ProviderContracts", fields: [providerId], references: [id], onDelete: Restrict)
  milestones   Milestone[]
  deliveries   Delivery[]
  transactions Transaction[]
  disputes     Dispute[]
  reviews      Review[]

  @@map("contracts")
}

model Milestone {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId   String          @map("contract_id") @db.Uuid
  title        String
  amount       Decimal         @db.Decimal(12, 2)
  status       MilestoneStatus @default(pending)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  contract     Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]
  transactions Transaction[]

  @@map("milestones")
}

model Delivery {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId   String         @map("contract_id") @db.Uuid
  milestoneId  String?        @map("milestone_id") @db.Uuid
  deliveryText String?        @map("delivery_text")
  fileUrl      String?        @map("file_url")
  fileName     String?        @map("file_name")
  status       DeliveryStatus @default(pending_review)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  contract     Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone    Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  revisions    Revision[]

  @@map("deliveries")
}

model Revision {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("revisions")
}

model Transaction {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId     String?           @map("contract_id") @db.Uuid
  milestoneId    String?           @map("milestone_id") @db.Uuid
  senderId       String            @map("sender_id") @db.Uuid
  receiverId     String            @map("receiver_id") @db.Uuid
  amount         Decimal           @db.Decimal(12, 2)
  type           TransactionType
  status         TransactionStatus @default(pending)
  paymentGateway String?           @map("payment_gateway")
  referenceId    String?           @map("reference_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  contract       Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  milestone      Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  sender         User              @relation("SentTransactions", fields: [senderId], references: [id])
  receiver       User              @relation("ReceivedTransactions", fields: [receiverId], references: [id])

  @@map("transactions")
}

model Dispute {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId        String        @map("contract_id") @db.Uuid
  raisedById        String        @map("raised_by_id") @db.Uuid
  reason            String
  status            DisputeStatus @default(open)
  resolutionDetails String?       @map("resolution_details")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  contract          Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  raisedBy          User          @relation(fields: [raisedById], references: [id], onDelete: Restrict)

  @@map("disputes")
}

model Review {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId         String   @map("contract_id") @db.Uuid
  reviewerId         String   @map("reviewer_id") @db.Uuid
  revieweeId         String   @map("reviewee_id") @db.Uuid
  ratingQuality      Int      @map("rating_quality")
  ratingCommunication Int     @map("rating_communication")
  ratingTimeliness   Int      @map("rating_timeliness")
  overallRating      Decimal  @map("overall_rating") @db.Decimal(3, 2)
  comment            String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  contract           Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewer           User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee           User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([contractId, reviewerId], name: "unique_contract_reviewer")
  @@map("reviews")
}

model ChatRoom {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String?      @map("job_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  members   ChatMember[]
  messages  Message[]

  @@map("chat_rooms")
}

model ChatMember {
  roomId String   @map("room_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("chat_members")
}

model Message {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  messageText String   @map("message_text")
  fileUrl     String?  @map("file_url")
  fileName    String?  @map("file_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@map("messages")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
